digraph Beacon {
  graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.6, ranksep=1.1, fontname="Helvetica", label="Beacon - AI Personal Career Coach\nER diagram (app: preparation)  |  Team Career Coaches, Group 11", labelloc=t, fontsize=18];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  Skill [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#13294B"><FONT COLOR="white"><B>Skill</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK id : BigAuto</TD></TR><TR><TD ALIGN="LEFT" PORT="1">name : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="2">category : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="3">description : Text</TD></TR><TR><TD ALIGN="LEFT" PORT="4">created_at : DateTime</TD></TR></TABLE>>];
  CandidateProfile [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#13294B"><FONT COLOR="white"><B>CandidateProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK id : BigAuto</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK user : OneToOne</TD></TR><TR><TD ALIGN="LEFT" PORT="2">target_role : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="3">target_company : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="4">experience_level : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="5">resume_summary : Text</TD></TR><TR><TD ALIGN="LEFT" PORT="6">resume_file : File</TD></TR><TR><TD ALIGN="LEFT" PORT="7">target_interview_date : Date</TD></TR><TR><TD ALIGN="LEFT" PORT="8">preparation_timeline_weeks : PositiveSmallInteger</TD></TR><TR><TD ALIGN="LEFT" PORT="9">primary_concern : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="10">created_at : DateTime</TD></TR><TR><TD ALIGN="LEFT" PORT="11">updated_at : DateTime</TD></TR><TR><TD ALIGN="LEFT" PORT="12">FK skills : ManyToMany</TD></TR></TABLE>>];
  SkillAssessment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#13294B"><FONT COLOR="white"><B>SkillAssessment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK id : BigAuto</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK candidate : ForeignKey</TD></TR><TR><TD ALIGN="LEFT" PORT="2">FK skill : ForeignKey</TD></TR><TR><TD ALIGN="LEFT" PORT="3">proficiency_score : PositiveSmallInteger</TD></TR><TR><TD ALIGN="LEFT" PORT="4">required_level : PositiveSmallInteger</TD></TR><TR><TD ALIGN="LEFT" PORT="5">assessed_on : Date</TD></TR><TR><TD ALIGN="LEFT" PORT="6">notes : Text</TD></TR></TABLE>>];
  PreparationPlan [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#13294B"><FONT COLOR="white"><B>PreparationPlan</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK id : BigAuto</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK candidate : ForeignKey</TD></TR><TR><TD ALIGN="LEFT" PORT="2">title : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="3">focus_role : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="4">start_date : Date</TD></TR><TR><TD ALIGN="LEFT" PORT="5">target_date : Date</TD></TR><TR><TD ALIGN="LEFT" PORT="6">status : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="7">generated_by_ai : Boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="8">created_at : DateTime</TD></TR></TABLE>>];
  PlanTask [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#13294B"><FONT COLOR="white"><B>PlanTask</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK id : BigAuto</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK plan : ForeignKey</TD></TR><TR><TD ALIGN="LEFT" PORT="2">FK skill : ForeignKey</TD></TR><TR><TD ALIGN="LEFT" PORT="3">title : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="4">week_number : PositiveSmallInteger</TD></TR><TR><TD ALIGN="LEFT" PORT="5">instructions : Text</TD></TR><TR><TD ALIGN="LEFT" PORT="6">rationale : Text</TD></TR><TR><TD ALIGN="LEFT" PORT="7">due_date : Date</TD></TR><TR><TD ALIGN="LEFT" PORT="8">estimated_minutes : PositiveInteger</TD></TR><TR><TD ALIGN="LEFT" PORT="9">priority : Integer</TD></TR><TR><TD ALIGN="LEFT" PORT="10">status : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="11">completed_on : Date</TD></TR></TABLE>>];
  User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#9AA7B8"><FONT COLOR="white"><B>User (django.contrib.auth)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK id : Auto</TD></TR><TR><TD ALIGN="LEFT" PORT="1">username : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="2">first_name : Char</TD></TR><TR><TD ALIGN="LEFT" PORT="3">email : Email</TD></TR></TABLE>>];
  User -> CandidateProfile [label="1 --- 1\nuser (CASCADE)", style=solid, color="#E84A27", arrowhead=crow];
  CandidateProfile -> Skill [label="skills (M2M through SkillAssessment)", style=dotted, color="#767676", arrowhead=veevee, arrowtail=veevee, dir=both];
  CandidateProfile -> SkillAssessment [label="1 --- N\ncandidate (CASCADE)", style=solid, color="#E84A27", arrowhead=crow];
  Skill -> SkillAssessment [label="1 --- N\nskill (PROTECT)", style=bold, color="#13294B", arrowhead=crow];
  CandidateProfile -> PreparationPlan [label="1 --- N\ncandidate (CASCADE)", style=solid, color="#E84A27", arrowhead=crow];
  PreparationPlan -> PlanTask [label="1 --- N\nplan (CASCADE)", style=solid, color="#E84A27", arrowhead=crow];
  Skill -> PlanTask [label="1 --- N\nskill (SET_NULL)", style=dashed, color="#767676", arrowhead=crow];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EEEEEE"><B>Legend</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#E84A27">solid</FONT> = on_delete CASCADE</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#13294B">bold</FONT> = on_delete PROTECT</TD></TR><TR><TD ALIGN="LEFT">dashed = on_delete SET_NULL</TD></TR><TR><TD ALIGN="LEFT">dotted = ManyToMany (through table)</TD></TR></TABLE>>];
}