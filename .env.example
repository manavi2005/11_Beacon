# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed. This file is the committed template: keys only, no secrets.
#
#   cp .env.example .env
#
# Generate a key for DJANGO_SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Plan generator (not wired up yet). The value below is a dummy placeholder;
# replace it with a real key when the feature starts.
PLAN_GENERATOR_API_KEY=dummy-key-not-a-real-secret

# Google OAuth (Assignment 5, Part 2). Create these in the Google Cloud
# console under APIs & Services > Credentials > OAuth client ID > Web
# application, then paste them into .env, which is git-ignored.
#
# The same client needs BOTH redirect URIs registered with Google:
#   http://127.0.0.1:8000/accounts/google/login/callback/
#   https://<your-domain>/accounts/google/login/callback/
#
# Leave these empty and the site still runs: the "Continue with Google"
# button simply does not render, because a button that cannot work is worse
# than no button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI coach (optional). Any OpenAI-compatible chat API works; leave the key
# empty and Beacon uses its built-in rule-based coach instead.
#
# Default: Groq free tier, open-weight Llama 3.3 70B. Free key at
# https://console.groq.com/keys
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=Groq
#
# Other free / open-model options (all on PythonAnywhere's allowlist):
#   Hugging Face:  LLM_BASE_URL=https://router.huggingface.co/v1
#                  LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct   (HF token as key)
#   OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1
#                  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Self-hosted:   LLM_BASE_URL=http://localhost:11434/v1   (Ollama; any key)
