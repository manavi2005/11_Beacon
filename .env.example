# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed. This file is the committed template: keys only, no secrets.
#
#   cp .env.example .env
#
# Generate a key for DJANGO_SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Plan generator (not wired up yet). The value below is a dummy placeholder;
# replace it with a real key when the feature starts.
PLAN_GENERATOR_API_KEY=dummy-key-not-a-real-secret
