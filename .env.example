# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed. This file is the committed template: keys only, no secrets.
#
#   cp .env.example .env
#
# Generate a key for DJANGO_SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Plan generator (not wired up yet). The value below is a dummy placeholder;
# replace it with a real key when the feature starts.
PLAN_GENERATOR_API_KEY=dummy-key-not-a-real-secret

# Google OAuth (Assignment 5, Part 2). Create these in the Google Cloud
# console under APIs & Services > Credentials > OAuth client ID > Web
# application, then paste them into .env, which is git-ignored.
#
# The same client needs BOTH redirect URIs registered with Google:
#   http://127.0.0.1:8000/accounts/google/login/callback/
#   https://<your-domain>/accounts/google/login/callback/
#
# Leave these empty and the site still runs: the "Continue with Google"
# button simply does not render, because a button that cannot work is worse
# than no button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI coach. Works with NO key: it uses Pollinations' free anonymous tier
# (OpenAI's open-weight gpt-oss-20b). Slower and rate-limited, but zero setup.
#
# Faster and more reliable, still free: a Groq key (open-weight Llama 3.3 70B).
# Free key at https://console.groq.com/keys
LLM_API_KEY=
# LLM_ENABLED=false      # rules-only coach, no network calls
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=Groq
#
# Other free / open-model options (all on PythonAnywhere's allowlist):
#   Hugging Face:  LLM_BASE_URL=https://router.huggingface.co/v1
#                  LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct   (HF token as key)
#   OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1
#                  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Self-hosted:   LLM_BASE_URL=http://localhost:11434/v1   (Ollama; any key)

# Local Hugging Face model (Assignment 6, Part 2.2). No key: the weights are
# downloaded by transformers into the Hugging Face cache on first use, about
# 3 GB for the default model, and everything after that runs on this machine.
#
# Nothing to set for normal development. The defaults are:
#   LOCAL_LLM_ENABLED=true                        (false in production.py)
#   LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct    (the lab's budget pick)
#   LOCAL_LLM_DEVICE=                             (empty: transformers decides)
#
# Switch it off if you would rather not hold a model in memory, or have not
# installed torch. Grading then goes straight to the hosted coach, which is
# also what the deployed site does.
# LOCAL_LLM_ENABLED=false
#
# Any other model from llm-test/ai_prototype.ipynb works here. The lab's
# quality-first pick, about 8 GB:
# LOCAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# The smallest one that still returned usable JSON, about 1 GB:
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
